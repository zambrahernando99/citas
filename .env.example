# ================================================================
# FCV TRAINING LAB · Proyecto de citas
# Copia este archivo a .env. NO subas .env a Git.
# ================================================================
COMPOSE_PROJECT_NAME=fcv-citas-training

MYSQL_DATABASE=citas_fcv_training
MYSQL_USER=citas_app
MYSQL_PASSWORD=CitasApp_2026!
MYSQL_ROOT_PASSWORD=RootCitas_2026!
MYSQL_PORT=3307

API_PORT=8080
REACT_PORT=5173
ANGULAR_PORT=4200

# Valores del backend Spring Boot.
DB_HOST=mysql
DB_PORT=3307
DB_NAME=citas_fcv_training
DB_USERNAME=citas_app
DB_PASSWORD=CitasApp_2026!

# Secreto sintético de laboratorio. Sustituir en cada repo personal y nunca versionar el valor real.
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:5173

# URL pública usada por el frontend cuando corra en el host.
VITE_API_URL=http://localhost:8080
