# ================================================================
# FCV TRAINING LAB · Proyecto de citas
# Copia este archivo a .env. NO subas .env a Git.
# ================================================================
COMPOSE_PROJECT_NAME=fcv-citas-training

# BD de la aplicación (Flyway). No usar citas_fcv_training: esa la crea
# database/reference/db.sql como esquema de referencia de solo consulta.
MYSQL_DATABASE=citas_app
MYSQL_USER=citas_app
MYSQL_PASSWORD=CitasApp_2026!
MYSQL_ROOT_PASSWORD=RootCitas_2026!
MYSQL_PORT=3307

API_PORT=8080
REACT_PORT=5173
ANGULAR_PORT=4200

# Valores del backend Spring Boot.
DB_HOST=mysql
DB_PORT=3307
DB_NAME=citas_app
DB_USERNAME=citas_app
DB_PASSWORD=CitasApp_2026!

# Secreto sintético de laboratorio. Sustituir en cada repo personal y nunca versionar el valor real.
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:5173

# S5 / WF-001: clave de máquina para n8n (mínimo 32 caracteres aleatorios).
# Se configura igual en la credencial Header Auth de n8n. Vacía = endpoints de automatización cerrados.
AUTOMATION_API_KEY=
REMINDER_DEFAULT_WINDOW_HOURS=24
REMINDER_MAX_ATTEMPTS=3

# URL pública usada por el frontend cuando corra en el host.
VITE_API_URL=http://localhost:8080

# S6 / WF-002: URL del webhook de n8n (https) y secreto de la credencial Header Auth (X-Citas-Webhook-Secret).
# Vacíos = los eventos quedan PENDING en el outbox y no se envían.
N8N_STATUS_WEBHOOK_URL=
N8N_STATUS_WEBHOOK_SECRET=
N8N_EVENT_MAX_ATTEMPTS=5

# S5/S6: túnel ngrok en Docker (docker compose --profile tunnel up -d ngrok).
# Authtoken personal del panel de ngrok (no versionar) y tu dominio estático gratuito.
NGROK_AUTHTOKEN=
NGROK_URL=https://TU-DOMINIO.ngrok-free.app
